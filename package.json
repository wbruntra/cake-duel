{
  "name": "2026-05-03-cake-duel",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run backend & sleep 1 && bun run frontend",
    "frontend": "cd frontend && bun run dev",
    "backend": "bun --watch index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:update": "bun scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build": "cd frontend && bun run build",
    "deploy": "ansible-playbook -i ansible/inventory.yml ansible/deploy.yml -e deployment=production",
    "deploy:nginx": "ansible-playbook -i ansible/inventory.yml ansible/deploy-nginx.yml -e deployment=production",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,html,md}\" \"!**/node_modules/**\" \"!**/dist/**\" \"!**/*.lock\" \"!**/cake-duel.db\"",
    "ai:self-play": "bun run src/ai/mcts/self-play.ts",
    "ai:evaluate": "bun run src/ai/mcts/evaluate.ts",
    "ai:train": "bun run src/ai/mcts/self-play.ts medium medium 1000"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.13",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "hono": "4.12.16",
    "sharp": "^0.34.5"
  }
}
